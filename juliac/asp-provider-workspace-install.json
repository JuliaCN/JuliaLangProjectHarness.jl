{
  "schemaId": "agent.semantic-protocols.provider-workspace-install",
  "schemaVersion": "1",
  "schemaAuthority": "https://tao3k.github.io/agent-semantic-protocols/schemas/",
  "providerId": "julia-lang-project-harness",
  "binary": "asp-julia-harness",
  "workspaceArtifact": {
    "root": "languages/JuliaLangProjectHarness.jl/build/juliac-asp-local/asp-julia-harness",
    "entrypoint": "."
  },
  "workspaceBuild": {
    "program": "./juliac/build_provider.sh",
    "args": [],
    "workingDirectory": "languages/JuliaLangProjectHarness.jl",
    "sourceSnapshotAnchors": [
      "languages/JuliaLangProjectHarness.jl/Project.toml",
      "languages/JuliaLangProjectHarness.jl/Manifest.toml",
      "languages/JuliaLangProjectHarness.jl/juliac/Project.toml",
      "languages/JuliaLangProjectHarness.jl/juliac/Manifest.toml",
      "languages/JuliaLangProjectHarness.jl/juliac/build_provider.sh"
    ],
    "derivedPaths": [
      "languages/JuliaLangProjectHarness.jl/build"
    ],
    "env": {
      "ASP_JULIA_ALLOW_WRAPPER_FALLBACK": "0",
      "ASP_JULIA_BUILD_DIR": "build/juliac-asp-local"
    }
  }
}
